      <Body><![CDATA[# ==============================================================================
#
# GUIDELINES FOR USING TEMPLATE FOR NAFION IONIC CONDUCTIVITY CUSTOM 1 MODEL
#
#
# To implement the desired custom correlation, ONLY MAKE CHANGES WITHIN THE 
# SECTIONS HIGHLIGHTED AS 'USER-DEFINED' BELOW. Do not make changes to the
# sections highlighted as 'DO NOT CHANGE'.
#
#
# For details on the gPROMS custom modelling language used within gPROMS
# Process, please consult the following sections of the online documentation:
# 1. Custom Modelling in gPROMS
# 2. Workflow Guides --> gML Process --> Custom modelling in gPROMS Process
#
# ==============================================================================

PARAMETER
# ==============================================================================
# DO NOT CHANGE
# ------------------------------------------------------------------------------

  input_names       AS  ORDERED_SET
  components        AS  ORDERED_SET


# ==============================================================================
# USER-DEFINED parameters
# ------------------------------------------------------------------------------


# ====================  END OF USER-DEFINED parameters  ========================

VARIABLE
# ==============================================================================
# DO NOT CHANGE
# ------------------------------------------------------------------------------
  # these will be the variables coming from the mass/energy balance models as inputs
  # can be passed to interface model via port or equations in interface model
  pressure          AS                          pressure_bar_gML
  temperature       AS                          temperature_gML
  molar_fraction    AS  ARRAY(components)   OF  molar_fraction_ECR
  water_sulfonic_ratio  AS                      no_type_gML

  # these are the inputs specific to this correlation - defined here
  parameters        AS  ARRAY(input_names)  OF  no_type_gML

  # this is the model output
  # can be passed to interface model via port or equations in interface model  
  value             AS                          electric_conductivity_ECR

# ==============================================================================
# USER-DEFINED variables
# ------------------------------------------------------------------------------


# =====================  END OF USER-DEFINED variables  ========================

SET
# ==============================================================================
# USER-DEFINED parameter specifications
# ------------------------------------------------------------------------------

  # insert parameter names between the brackets below
  input_names := ['Constant', 'Linear dependance on KOH', 'Temperature parameter'] ;  

# ===============  END OF USER-DEFINED parameter specifications  ===============

EQUATION
# ==============================================================================
# USER-DEFINED equations. CHANGE AS REQUIRED.
# ------------------------------------------------------------------------------

  # define the ionic conductivity correlation below
  value = (  parameters('Constant')
           + parameters('Linear dependance on KOH') * ( 1 - molar_fraction('water') ) 
          ) * EXP( parameters('Temperature parameter') * (1/343.15 - 1/temperature) ) ;

# =======================  END OF USER-DEFINED equations  ======================
]]></Body>
    </ModelEntity>
