    Cathode_out_2b AS Sink_material_gML
    PEM_2 AS Reactor_electrochemical_cell_gML
    SOEC_2 AS Reactor_electrochemical_cell_gML

SET

TOPOLOGY
    Anode_out_1a.inlet = AEL_AEM_1.outlet_anode;
    Anode_in_1a.outlet = AEL_AEM_1.inlet_anode;
    AEL_AEM_1.inlet_cathode = Cathode_in_1a.outlet;
