UNIT
    Conversion_gML001 AS Conversion_gML
    Electrochemical_cell_reactor_ECR001 AS Electrochemical_cell_reactor_ECR
    Anode_Feed_water_001 AS Source_material_gML
    Cathode_Feed_CO001 AS Source_material_gML
    anode_out AS Sink_material_gML
    Mixer_gML001 AS Mixer_gML
    Stream_analyzer_gML001 AS Stream_analyzer_gML
    Hollow_fiber_module_gML001 AS Hollow_fiber_module_gML
    Cooler_gML001 AS Cooler_gML
    Compressor_centrifugal_gML001 AS Compressor_centrifugal_gML
    Source_material_gML001 AS Source_material_gML
    Sink_material_gML002 AS Sink_material_gML
    Splitter_gML001 AS Splitter_gML
    Stream_analyzer_gML002 AS Stream_analyzer_gML
    Sink_material_gML001 AS Sink_material_gML
    Sink_material_gML003 AS Sink_material_gML
    Stream_analyzer_gML003 AS Stream_analyzer_gML
    Stream_analyzer_gML004 AS Stream_analyzer_gML
SET

TOPOLOGY
    Anode_Feed_water_001.outlet = Electrochemical_cell_reactor_ECR001.inlet_anode;
    Cathode_Feed_CO001.setPort(1) = Conversion_gML001.Inlet(1);
    Electrochemical_cell_reactor_ECR001.outlet_anode = anode_out.inlet;
    Cathode_Feed_CO001.outlet = Mixer_gML001.inlet(1);
    Mixer_gML001.outlet = Electrochemical_cell_reactor_ECR001.inlet_cathode;
    Electrochemical_cell_reactor_ECR001.outlet_cathode = Stream_analyzer_gML001.inlet;
    Conversion_gML001.Outlet(1) = Stream_analyzer_gML001.setPort(1);
    Stream_analyzer_gML001.outlet = Cooler_gML001.inlet;
    Cooler_gML001.outlet = Compressor_centrifugal_gML001.Inlet;
    Compressor_centrifugal_gML001.Outlet = Hollow_fiber_module_gML001.inlet_shell_side;
    Source_material_gML001.outlet = Hollow_fiber_module_gML001.inlet_bore_side;
    Hollow_fiber_module_gML001.outlet_bore_side = Sink_material_gML002.inlet;
    Hollow_fiber_module_gML001.outlet_shell_side = Stream_analyzer_gML002.inlet;
    Stream_analyzer_gML002.outlet = Splitter_gML001.Inlet;
    Splitter_gML001.Outlet(1) = Stream_analyzer_gML003.inlet;
    Splitter_gML001.Outlet(2) = Stream_analyzer_gML004.inlet;
    Stream_analyzer_gML004.outlet = Sink_material_gML001.inlet;
    Stream_analyzer_gML003.outlet = Sink_material_gML003.inlet;

]]></Body>
