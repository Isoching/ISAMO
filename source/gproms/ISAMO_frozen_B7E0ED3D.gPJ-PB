      <Body><![CDATA[UNIT
    Electrochemical_cell_reactor_ECR001 AS Electrochemical_cell_reactor_ECR
    Anode_Feed_water_001 AS Source_material_gML
    Cathode_Feed_CO001 AS Source_material_gML
    Anode_Sink_001 AS Sink_material_gML
    Sink001 AS Sink_material_gML
    Conversion_gML001 AS Conversion_gML
SET

TOPOLOGY
    Anode_Feed_water_001.outlet = Electrochemical_cell_reactor_ECR001.inlet_anode;
    Cathode_Feed_CO001.outlet = Electrochemical_cell_reactor_ECR001.inlet_cathode;
    Electrochemical_cell_reactor_ECR001.outlet_anode = Anode_Sink_001.inlet;
    Electrochemical_cell_reactor_ECR001.outlet_cathode = Sink001.inlet;
    Cathode_Feed_CO001.setPort(1) = Conversion_gML001.Inlet(1);
    Conversion_gML001.Outlet(1) = Sink001.setPort(1);

]]></Body>
