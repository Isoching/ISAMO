    Cap_First_stage.outlet_bore_side = SA_retentate.inlet;
    Cap_First_stage.inlet_shell_side = SA_in_1.outlet;
    Cap_First_stage.inlet_bore_side = SA_1.outlet;
    CO2product.outlet = Compressor_centrifugal_gML001.Inlet;
    Compressor_centrifugal_gML001.Outlet = Cooler_gML001.inlet;
    Anode_Feed_water_001.outlet = eCO2R.inlet_anode;
    eCO2R.outlet_anode = Anode_Sink_001.inlet;
    Cooler_gML001.outlet = SA_product001.inlet;
    SA_product001.outlet = Material_adapter_gML001.inlet;
    Material_adapter_gML001.outlet = eCO2R.inlet_cathode;
    Separator_gML001.vapour_outlet = Splitter_gML001.Inlet;
    Splitter_gML001.Outlet(1) = Sink_material_gML002.inlet;
    Me_reactor.outlet = Stream_analyzer_gML001.inlet;
