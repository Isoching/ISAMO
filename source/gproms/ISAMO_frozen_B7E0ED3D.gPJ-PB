      <Body><![CDATA[# PARAMETER
# ParameterName AS INTEGER || REAL || LOGICAL || VariableType < DEFAULT Value >
# ParameterName AS ARRAY ( Size < , ... > ) OF INTEGER || REAL || LOGICAL || VariableType < DEFAULT Value >
# ParameterName AS FOREIGN_OBJECT < "ForeignObjectClass" > < DEFAULT "ForeignObjectValue" >
# ParameterName AS ORDERED_SET < DEFAULT [ "Name" < , ... > ] >


# DISTRIBUTION_DOMAIN
# DomainName AS [ LowerBound : UpperBound ]
# DomainName AS ARRAY ( Size < , ... > ) OF [ LowerBound : UpperBound ]


# UNIT
# UnitName AS UnitModelName
# UnitName AS ARRAY ( Size || OrderedSet < , ... > ) OF UnitModelName


# PORT
# PortName AS ConnectionType < DIRECTION_INLET || DIRECTION_OUTLET || DIRECTION_BIDIRECTIONAL >
# PortName AS ARRAY ( Size || OrderedSet < , ... > ) OF ConnectionType <DIRECTION_INLET || DIRECTION_OUTLET || DIRECTION_BIDIRECTIONAL >


# VARIABLE
# VariableName AS VariableType
# VariableName AS ARRAY ( Size || OrderedSet < , ... > ) OF VariableType
# VariableName AS DISTRIBUTION ( DomainName < , ... > ) OF VariableType


# SELECTOR
# SelectorName AS ( Flag < , ... > ) < DEFAULT Flag >
# SelectorName AS ARRAY ( Size || OrderedSet < , ... > ) OF ( Flag < , ... > ) < DEFAULT Flag >
# SelectorName AS DISTRIBUTION ( DomainName < , ... > ) OF ( Flag < , ... > ) < DEFAULT Flag >


# SET
# ParameterPath := Expression ;
# ParameterPath := [ Expression < , ... > ];
# ParameterPath := "<ForeignObjectClass::>ForeignObjectValue";
# ParameterPath := [ "Name" < , ... > ];
# DomainPath := [ BFDM || CFDM || FFDM || OCFEM , Order , NumOfElements ];


# BOUNDARY
# Boundary condition equations


# TOPOLOGY
# Unit connection equations


# EQUATION
# Model equations


# ASSIGN
# VariablePath := Expression ;
# VariablePath := [ Expression < , ... > ];


# PRESET
# < RESTORE "filename" >
# VariablePath := InitialValue ;
# VariablePath := InitialValue : LowerBound : UpperBound ;


# INITIALSELECTOR
# SelectorPath := FlagPath ;
# SelectorPath := [ FlagPath < , ... > ];


# INITIAL
# Equations

UNIT
    SA_R1 AS Stream_analyzer_gML
    SA_in_2 AS Stream_analyzer_gML
    Cooler_1 AS Cooler_gML
    First_retentate AS sink_material_gML
    Expander AS Expander_gML
    Cooler_2 AS Cooler_gML
    SA_2 AS Stream_analyzer_gML
    First_stage AS Hollow_fiber_module_gML
    Dummy_1 AS Source_material_gML
    Second_stage AS Hollow_fiber_module_gML
    SA_retentate AS Stream_analyzer_gML
    Flue_gas AS Source_material_gML
    Mixer001 AS Mixer_gML
    RB AS Recycle_breaker_gML
    SA_flue_gas AS Stream_analyzer_gML
    SA_in_1 AS Stream_analyzer_gML
    SA_R2 AS Stream_analyzer_gML
    Recovery AS recovery_gML
    SA_1 AS Stream_analyzer_gML
    SA_product AS Stream_analyzer_gML
    Dummy_2 AS Source_material_gML
    C2 AS Compressor_centrifugal_gML
    C1 AS Compressor_centrifugal_gML
    Compressor_centrifugal_gML001 AS Compressor_centrifugal_gML
    Cooler_gML001 AS Cooler_gML
    Sink_material_gML001 AS Sink_material_gML

SET

TOPOLOGY
    SA_flue_gas.outlet = C1.Inlet;
    Expander.Outlet = SA_R1.inlet;
    C1.Outlet = Cooler_1.inlet;
    Cooler_1.outlet = Mixer001.inlet(2);
    Mixer001.outlet = SA_in_1.inlet;
    C2.Outlet = Cooler_2.inlet;
    Cooler_2.outlet = SA_in_2.inlet;
    SA_retentate.outlet = C2.Inlet;
    RB.outlet = Mixer001.inlet(1);
    SA_R2.outlet = RB.inlet;
    SA_R1.outlet = First_retentate.inlet;
    Flue_gas.setPort(1) = Recovery.Inlet(1);
    Flue_gas.outlet = SA_flue_gas.inlet;
    Dummy_1.outlet = SA_1.inlet;
    Dummy_1.setPort(1) = Recovery.Inlet(2);
    Dummy_2.outlet = SA_2.inlet;
    Dummy_2.setPort(1) = Recovery.Inlet(3);
    SA_2.outlet = Second_stage.inlet_bore_side;
    Second_stage.inlet_shell_side = SA_in_2.outlet;
    Second_stage.outlet_shell_side = SA_R2.inlet;
    Second_stage.outlet_bore_side = SA_product.inlet;
    First_stage.outlet_shell_side = Expander.Inlet;
    First_stage.outlet_bore_side = SA_retentate.inlet;
    First_stage.inlet_shell_side = SA_in_1.outlet;
    First_stage.inlet_bore_side = SA_1.outlet;
    SA_product.outlet = Compressor_centrifugal_gML001.Inlet;
    Compressor_centrifugal_gML001.Outlet = Cooler_gML001.inlet;
    Cooler_gML001.outlet = Sink_material_gML001.inlet;

]]></Body>
