    Anode_in_1b.outlet = PEM_1.inlet_anode;
    PEM_1.inlet_cathode = Cathode_in_1b.outlet;
    PEM_1.outlet_cathode = Cathode_out_1b.inlet;
    Anode_out_1c.inlet = SOEC_1.outlet_anode;
    Anode_in_1c.outlet = SOEC_1.inlet_anode;
    SOEC_1.inlet_cathode = Cathode_in_1c.outlet;
    SOEC_1.outlet_cathode = Cathode_out_1c.inlet;
    Anode_out_2a.inlet = AEL_AEM_2.outlet_anode;
    Anode_in_2a.outlet = AEL_AEM_2.inlet_anode;
    AEL_AEM_2.inlet_cathode = Cathode_in_2a.outlet;
    AEL_AEM_2.outlet_cathode = Cathode_out_2a.inlet;
    Anode_out_2b.inlet = PEM_2.outlet_anode;
