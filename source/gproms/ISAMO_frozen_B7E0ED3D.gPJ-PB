      <Body><![CDATA[# PARAMETER
# ParameterName AS INTEGER || REAL || LOGICAL || VariableType < DEFAULT Value >
# ParameterName AS ARRAY ( Size < , ... > ) OF INTEGER || REAL || LOGICAL || VariableType < DEFAULT Value >
# ParameterName AS FOREIGN_OBJECT < "ForeignObjectClass" > < DEFAULT "ForeignObjectValue" >
# ParameterName AS ORDERED_SET < DEFAULT [ "Name" < , ... > ] >


# DISTRIBUTION_DOMAIN
# DomainName AS [ LowerBound : UpperBound ]
# DomainName AS ARRAY ( Size < , ... > ) OF [ LowerBound : UpperBound ]


# UNIT
# UnitName AS UnitModelName
# UnitName AS ARRAY ( Size || OrderedSet < , ... > ) OF UnitModelName


# PORT
# PortName AS ConnectionType < DIRECTION_INLET || DIRECTION_OUTLET || DIRECTION_BIDIRECTIONAL >
# PortName AS ARRAY ( Size || OrderedSet < , ... > ) OF ConnectionType <DIRECTION_INLET || DIRECTION_OUTLET || DIRECTION_BIDIRECTIONAL >


# VARIABLE
# VariableName AS VariableType
# VariableName AS ARRAY ( Size || OrderedSet < , ... > ) OF VariableType
# VariableName AS DISTRIBUTION ( DomainName < , ... > ) OF VariableType


# SELECTOR
# SelectorName AS ( Flag < , ... > ) < DEFAULT Flag >
# SelectorName AS ARRAY ( Size || OrderedSet < , ... > ) OF ( Flag < , ... > ) < DEFAULT Flag >
# SelectorName AS DISTRIBUTION ( DomainName < , ... > ) OF ( Flag < , ... > ) < DEFAULT Flag >


# SET
# ParameterPath := Expression ;
# ParameterPath := [ Expression < , ... > ];
# ParameterPath := "<ForeignObjectClass::>ForeignObjectValue";
# ParameterPath := [ "Name" < , ... > ];
# DomainPath := [ BFDM || CFDM || FFDM || OCFEM , Order , NumOfElements ];


# BOUNDARY
# Boundary condition equations


# TOPOLOGY
# Unit connection equations


# EQUATION
# Model equations


# ASSIGN
# VariablePath := Expression ;
# VariablePath := [ Expression < , ... > ];


# PRESET
# < RESTORE "filename" >
# VariablePath := InitialValue ;
# VariablePath := InitialValue : LowerBound : UpperBound ;


# INITIALSELECTOR
# SelectorPath := FlagPath ;
# SelectorPath := [ FlagPath < , ... > ];


# INITIAL
# Equations

UNIT
    Mixer_gML001 AS Mixer_gML
    Reactor_tubular_gML001 AS Reactor_tubular_gML
    Separator_gML001 AS Separator_gML
    Source_material_gML001 AS Source_material_gML
    Splitter_gML001 AS Splitter_gML
    Sink_material_gML002 AS Sink_material_gML
    Stream_analyzer_gML001 AS Stream_analyzer_gML
    Conversion_gML001 AS Conversion_gML
    Cooler_gML001 AS Cooler_gML
    Heater_gML001 AS Heater_gML
    Valve_gML001 AS Valve_gML
    Separator_gML002 AS Separator_gML
    Valve_gML002 AS Valve_gML
    Sink_material_gML003 AS Sink_material_gML
    Stream_analyzer_gML002 AS Stream_analyzer_gML
    Cooler_gML003 AS Cooler_gML
    Heater_gML002 AS Heater_gML
    Compressor_centrifugal_gML001 AS Compressor_centrifugal_gML
    Cooler_gML002 AS Cooler_gML
    Cooler_gML004 AS Cooler_gML
    Compressor_centrifugal_gML002 AS Compressor_centrifugal_gML
    Compressor_centrifugal_gML003 AS Compressor_centrifugal_gML
    Stream_analyzer_gML003 AS Stream_analyzer_gML
    Sink_material_gML001 AS Sink_material_gML
SET

TOPOLOGY
    Separator_gML001.vapour_outlet = Splitter_gML001.Inlet;
    Splitter_gML001.Outlet(1) = Sink_material_gML002.inlet;
    Reactor_tubular_gML001.outlet = Stream_analyzer_gML001.inlet;
    Conversion_gML001.Inlet(1) = Source_material_gML001.setPort(1);
    Conversion_gML001.Outlet(1) = Stream_analyzer_gML001.setPort(1);
    Stream_analyzer_gML001.outlet = Cooler_gML001.inlet;
    Cooler_gML001.outlet = Separator_gML001.inlet;
    Separator_gML002.liquid_outlet = Valve_gML002.inlet;
    Separator_gML002.vapour_outlet = Sink_material_gML003.inlet;
    Separator_gML001.liquid_outlet = Stream_analyzer_gML002.inlet;
    Stream_analyzer_gML002.outlet = Valve_gML001.inlet;
    Valve_gML001.outlet = Cooler_gML003.inlet;
    Cooler_gML003.outlet = Separator_gML002.inlet;
    Valve_gML002.outlet = Heater_gML002.inlet;
    Source_material_gML001.outlet = Compressor_centrifugal_gML001.Inlet;
    Compressor_centrifugal_gML001.Outlet = Cooler_gML002.inlet;
    Cooler_gML002.outlet = Compressor_centrifugal_gML002.Inlet;
    Compressor_centrifugal_gML002.Outlet = Cooler_gML004.inlet;
    Cooler_gML004.outlet = Compressor_centrifugal_gML003.Inlet;
    Mixer_gML001.outlet = Heater_gML001.inlet;
    Heater_gML001.outlet = Reactor_tubular_gML001.inlet;
    Compressor_centrifugal_gML003.Outlet = Mixer_gML001.inlet(1);
    Splitter_gML001.Outlet(2) = Mixer_gML001.inlet(2);
    Heater_gML002.outlet = Stream_analyzer_gML003.inlet;
    Stream_analyzer_gML003.outlet = Sink_material_gML001.inlet;

]]></Body>
