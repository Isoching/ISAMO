      <Body><![CDATA[UNIT
    Feed AS Source_material_gML
    Oxygen AS Sink_material_gML
    An_cond_sep AS Separator_gML
    Anode_Separator AS Separator_gML
    Ca_cond_sep AS Separator_gML
    Cathode_Separator AS Separator_gML
    Electrolyser AS Electrochemical_cell_reactor_ECR
    Dryer AS Component_splitter_gML
    Cooler AS Cooler_gML
    Power_input AS Source_energy_gML
    MX AS Mixer_gML
    MX_2 AS Mixer_gML
    V_G_Anode AS Valve_gML
    V_G_Cathode AS Valve_gML
    V_L_Anode AS Valve_gML
    V_L_Cathode AS Valve_gML
    SP AS Splitter_gML
    An_liquid AS Stream_analyzer_gML
    Ca_liquid AS Stream_analyzer_gML
    Stream_4 AS Stream_analyzer_gML
    F_calc AS Adj_spec_gML
    Loop_breaker AS Loop_breaker_gML
    P_set AS Calc_spec_gML
    SP_calc AS Adj_spec_gML
    Pump AS Pump_gML
    P_out_set AS Calc_spec_gML
    TI_H2 AS Stream_analyzer_gML
    Deoxy AS Reactor_Gibbs_gML
    Post_combustion_cooler AS Cooler_gML
    hydrogen_continuity AS Calc_spec_gML
    oxygen_continuity AS Calc_spec_gML
    water_continuity AS Calc_spec_gML
    SA AS Stream_analyzer_gML
    RB AS Recycle_breaker_gML
    An_cond_cooler AS Cooler_gML
    Ca_cond_cooler AS Cooler_gML
    An_cond_MX AS Mixer_gML
    Ca_cond_MX AS Mixer_gML
    RB_An_cond AS Recycle_breaker_gML
    RB_Ca_cond AS Recycle_breaker_gML
    F_set AS Source_constant_variable_gML
    F_setpoint AS Set_signal_to_created_bus_gML
    F_set_2 AS Set_signal_to_bus_gML
    Stream_analyzer_gML001 AS Stream_analyzer_gML
    Sink_material_gML001 AS Sink_material_gML
    Stream_analyzer_gML002 AS Stream_analyzer_gML
    Stream_analyzer_gML003 AS Stream_analyzer_gML

SET

TOPOLOGY
    MX_2.inlet(1) = MX.outlet;
    Stream_4.outlet = Oxygen.inlet;
    Stream_4.inlet = V_G_Anode.outlet;
    F_calc.Adjust = Feed.setPort(1);
    SP_calc.Adjust = SP.setPort(1);
    Loop_breaker.outlet = Cooler.inlet;
    Feed.outlet = MX_2.inlet(2);
    MX_2.outlet = Pump.inlet;
    TI_H2.outlet = Deoxy.Inlet;
    Post_combustion_cooler.inlet = Deoxy.Outlet;
    Post_combustion_cooler.outlet = Dryer.inlet;
    Pump.outlet = SA.inlet;
    SA.outlet = Loop_breaker.inlet;
    RB.inlet = Cooler.outlet;
    RB.outlet = SP.Inlet;
    Cathode_Separator.vapour_outlet = Ca_cond_cooler.inlet;
    Ca_cond_sep.liquid_outlet = RB_Ca_cond.inlet;
    Ca_cond_cooler.outlet = Ca_cond_sep.inlet;
    Cathode_Separator.liquid_outlet = Ca_cond_MX.inlet(1);
    Ca_cond_MX.outlet = V_L_Cathode.inlet;
    Ca_cond_MX.inlet(2) = RB_Ca_cond.outlet;
    An_cond_sep.vapour_outlet = V_G_Anode.inlet;
    RB_An_cond.inlet = An_cond_sep.liquid_outlet;
    Anode_Separator.vapour_outlet = An_cond_cooler.inlet;
    An_cond_cooler.outlet = An_cond_sep.inlet;
    An_cond_MX.outlet = V_L_Anode.inlet;
    An_cond_MX.inlet(1) = Anode_Separator.liquid_outlet;
    RB_An_cond.outlet = An_cond_MX.inlet(2);
    An_liquid.outlet = MX.inlet(2);
    V_L_Anode.outlet = An_liquid.inlet;
    SP_calc.external_target(1) = An_liquid.setPort(1);
    MX.inlet(1) = Ca_liquid.outlet;
    Ca_liquid.inlet = V_L_Cathode.outlet;
    SP_calc.target = Ca_liquid.setPort(1);
    Ca_cond_sep.vapour_outlet = V_G_Cathode.inlet;
    V_G_Cathode.outlet = TI_H2.inlet;
    Pump.setPort(1) = P_out_set.Inlet;
    P_out_set.Outlet = Loop_breaker.setPort(1);
    SP.Outlet(1) = Electrolyser.inlet_anode;
    SP.Outlet(2) = Electrolyser.inlet_cathode;
    oxygen_continuity.Inlet = SA.setPort(1);
    water_continuity.Inlet = SA.setPort(2);
    hydrogen_continuity.Inlet = SA.setPort(3);
    Loop_breaker.setPort(2) = oxygen_continuity.Outlet;
    water_continuity.Outlet = Loop_breaker.setPort(3);
    hydrogen_continuity.Outlet = Loop_breaker.setPort(4);
    P_set.Outlet = Feed.setPort(2);
    P_set.Inlet = MX_2.setPort(1);
    F_calc.target = MX_2.setPort(2);
    F_set.out = F_setpoint.signalPort;
    F_setpoint.setPort(1) = F_calc.external_target(1);
    F_set_2.Outlet = Loop_breaker.setPort(5);
    F_set_2.signalPort = F_set.out;
    Power_input.outlet = Electrolyser.Input_power;
    Dryer.outlet(1) = Stream_analyzer_gML001.inlet;
    Stream_analyzer_gML001.outlet = Sink_material_gML001.inlet;
    Electrolyser.outlet_cathode = Stream_analyzer_gML003.inlet;
    Stream_analyzer_gML003.outlet = Cathode_Separator.inlet;
    Electrolyser.outlet_anode = Stream_analyzer_gML002.inlet;
    Stream_analyzer_gML002.outlet = Anode_Separator.inlet;

]]></Body>
