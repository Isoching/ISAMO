      <TextBlock layer="Layer 1" zorder="2147483647">
        <Transform ScaleX="1955.0" ScaleY="230.0" ShearX="0.0" ShearY="0.0" TranslateX="160.915303088425" TranslateY="0.10090299248440715"/>
        <Content>
          <span size="36.0" bold="true">Membrane-based CO2 Capture System for a Coal-fired Power Plant</span>
          <span>
</span>
          <span size="32.0">Two-stage membrane system for carbon dioxide capture </span>
          <span size="26.0">from a mixture of carbon dioxide and nitrogen.
</span>
          <span size="26.0">This example is partially based on literature (DOI: 10.1016/j.egypro.2013.05.209). Inlet 0.882 % N2 0.118 % CO2, total flow rate is 100 kmol/h; Recovery CO2: 0.986, Purity CO2: 0.923</span>
        </Content>
        <Border style="NO_BORDER" width="1">
          <lineColour Red="0" Green="0" Blue="0"/>
          <shadowColour Red="0" Green="0" Blue="0"/>
        </Border>
      </TextBlock>
